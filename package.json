{
  "name": "lazeaway",
  "productName": "LazeAway",
  "description": "Native desktop controller for the Artilume S1 6W Foldable Laser Engraver (ACMER S1 clone) - Texas Guitar Edition",
  "author": "LazeAway",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5199 && cross-env VITE_DEV_SERVER_URL=http://localhost:5199 electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/make-electron-pkg.mjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "lint": "oxlint",
    "start": "electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.lazeaway.desktop",
    "productName": "Artilume S1 Desktop Controller",
    "artifactName": "LazeAway-${version}-Setup.${ext}",
    "copyright": "Copyright © 2026 LazeAway",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**",
      "**/node_modules/bindings/**",
      "**/node_modules/node-gyp-build/**",
      "**/node_modules/@mapbox/node-pre-gyp/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LazeAway"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false
    },
    "npmRebuild": false
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
